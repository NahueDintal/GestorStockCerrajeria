<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cerrajeria.controller.ProductoFormController"
      spacing="15">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110" prefWidth="120"/>
            <ColumnConstraints prefWidth="220" hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="110" prefWidth="120"/>
            <ColumnConstraints prefWidth="220" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Marca:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtMarca" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Categoría:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbCategoria" GridPane.rowIndex="1" GridPane.columnIndex="1"
                  maxWidth="Infinity"/>
        <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtTipo" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Modelo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtModelo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Material:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="txtMaterial" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Medidas:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMedidas" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Color:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <TextField fx:id="txtColor" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

        <Label text="Proveedor:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtProveedor" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Ubicación:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <TextField fx:id="txtUbicacion" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

        <Label text="Precio costo:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrecioCosto" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Precio venta:" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        <TextField fx:id="txtPrecioVenta" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

        <Label text="Stock:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtStock" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label text="Stock mínimo:" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
        <TextField fx:id="txtStockMinimo" GridPane.rowIndex="6" GridPane.columnIndex="3"/>

        <Label text="Activo:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <CheckBox fx:id="chkActivo" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Descripción:"/>
    <TextArea fx:id="txtDescripcion" prefRowCount="2" wrapText="true"/>

    <Label text="Observaciones:"/>
    <TextArea fx:id="txtObservaciones" prefRowCount="2" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar"/>
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar"
                defaultButton="true" style="-fx-base: #4CAF50;"/>
    </HBox>
</VBox>
