<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cerrajeria.controller.PresupuestoController">

    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Buscar producto:"/>
            <TextField fx:id="txtBuscarProducto" prefWidth="260"
                       promptText="Nombre, marca, modelo..."/>
            <Label text="Categoría:"/>
            <ComboBox fx:id="cbFiltroCategoria" prefWidth="160"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNumero" text="N° —"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5">
            <items>

                <VBox spacing="8">
                    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProdNombre" text="Nombre" prefWidth="240"/>
                            <TableColumn fx:id="colProdMarca"  text="Marca"  prefWidth="110"/>
                            <TableColumn fx:id="colProdPrecio" text="Precio" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="Escribí arriba para filtrar productos."/>
                        </placeholder>
                    </TableView>
                    <Button text="Agregar al presupuesto ➡"
                            onAction="#agregarSeleccionado"
                            maxWidth="Infinity"
                            style="-fx-base: #4CAF50;"/>
                </VBox>

                <BorderPane>
                    <top>
                        <Label text="🛒 Presupuesto"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"
                               BorderPane.alignment="CENTER_LEFT">
                            <BorderPane.margin><Insets bottom="6"/></BorderPane.margin>
                        </Label>
                    </top>

                    <center>
                        <TableView fx:id="tablaCarrito" editable="true">
                            <columns>
                                <TableColumn fx:id="colItemProducto" text="Producto" prefWidth="200"/>
                                <TableColumn fx:id="colItemCantidad" text="Cant." prefWidth="60"/>
                                <TableColumn fx:id="colItemPrecio"   text="P. Unit" prefWidth="90"/>
                                <TableColumn fx:id="colItemSubtotal" text="Subtotal" prefWidth="90"/>
                                <TableColumn fx:id="colItemQuitar"   text="" prefWidth="40"/>
                            </columns>
                            <placeholder>
                                <Label text="Doble clic en un producto para agregarlo."/>
                            </placeholder>
                        </TableView>
                    </center>

                    <bottom>
                        <VBox spacing="8">
                            <padding><Insets top="10"/></padding>

                            <GridPane hgap="10" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints minWidth="90"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtClienteNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Teléfono:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtClienteTelefono" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <Label text="Descuento %:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtDescuentoGlobal" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Label text="Observaciones:"/>
                            <TextArea fx:id="txtObservaciones" prefRowCount="2" wrapText="true"/>

                            <HBox spacing="12" alignment="CENTER_RIGHT">
                                <Label text="Subtotal:" style="-fx-font-size: 12px;"/>
                                <Label fx:id="lblSubtotal" text="\$0.00" style="-fx-font-size: 12px;"/>
                                <Label text="TOTAL:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label fx:id="lblTotal" text="\$0.00"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                                <Button text="📄 PDF" onAction="#exportarPDF"
                                        style="-fx-base: #2196F3;"/>
                                <Button text="Guardar" onAction="#guardar"
                                        style="-fx-base: #4CAF50;"/>
                                <Button text="Limpiar" onAction="#limpiar"/>
                            </HBox>
                        </VBox>
                    </bottom>
                </BorderPane>

            </items>
        </SplitPane>
    </center>
</BorderPane>
