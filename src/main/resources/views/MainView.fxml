<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cerrajeria.controller.MainController">

    <top>
        <MenuBar>
            <menus>
                <Menu text="Archivo">
                    <items>
                        <MenuItem text="Salir" onAction="#salir"/>
                    </items>
                </Menu>
                <Menu text="Ayuda">
                    <items>
                        <MenuItem text="Acerca de" onAction="#acercaDe"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Productos">
                    <fx:include source="ProductoView.fxml"/>
                </Tab>
                <Tab text="Presupuestos">
                    <fx:include source="PresupuestoView.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <javafx.geometry.Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
            <Label text="Cerrajería — Lista de Precios"
                   style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>
