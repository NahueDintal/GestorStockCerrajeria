<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.cerrajeria.util.ToggleSwitch?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cerrajeria.controller.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <MenuBar fx:id="menuBar">
                <menus>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem text="Salir" onAction="#salir"/>
                        </items>
                        <items>
                            <MenuItem text="Importar productos desde CSV…" onAction="#importarCSV"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Salir" onAction="#salir"/>
                        </items>
                    </Menu>
                    <Menu text="Ver">
                        <items>
                            <MenuItem text="Tema claro"  onAction="#temaClaro"/>
                            <MenuItem text="Tema oscuro" onAction="#temaOscuro"/>
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem text="Acerca de" onAction="#acercaDe"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="8">
                <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
                <Label text="☀" styleClass="theme-icon"/>
                <ToggleSwitch fx:id="themeSwitch"/>
                <Label text="🌙" styleClass="theme-icon"/>
            </HBox>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Productos">
                    <fx:include source="ProductoView.fxml" fx:id="productoView" />
                </Tab>
                <Tab text="Presupuestos">
                    <fx:include source="PresupuestoView.fxml"/>
                </Tab>
                <Tab text="Historial">
                    <fx:include source="HistorialView.fxml" fx:id="historialView"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <javafx.geometry.Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
            <Label text="Cerrajería — Lista de Precios"
                   style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>
