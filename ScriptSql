-- Crear la base
CREATE DATABASE IF NOT EXISTS cerrajeria
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE cerrajeria;

-- Categorías (cerradura, candado, cámara, etc.)
CREATE TABLE IF NOT EXISTS categoria (
    id          INT AUTO_INCREMENT PRIMARY KEY,
    nombre      VARCHAR(50) NOT NULL UNIQUE
) ENGINE=InnoDB;

-- Productos
CREATE TABLE IF NOT EXISTS producto (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    codigo          VARCHAR(30)  NOT NULL UNIQUE,
    nombre          VARCHAR(120) NOT NULL,
    marca           VARCHAR(60),
    categoria_id    INT,
    tipo            VARCHAR(60),
    modelo          VARCHAR(60),
    material        VARCHAR(60),
    medidas         VARCHAR(60),
    color           VARCHAR(40),
    descripcion     TEXT,
    proveedor       VARCHAR(80),

    precio_costo    DECIMAL(12,2) NOT NULL DEFAULT 0,
    precio_venta    DECIMAL(12,2) NOT NULL DEFAULT 0,

    stock           INT NOT NULL DEFAULT 0,
    stock_minimo    INT NOT NULL DEFAULT 0,
    ubicacion       VARCHAR(60),

    activo          TINYINT(1) NOT NULL DEFAULT 1,
    fecha_alta      DATE NOT NULL,
    imagen          VARCHAR(255),
    observaciones   TEXT,

    CONSTRAINT fk_producto_categoria
        FOREIGN KEY (categoria_id) REFERENCES categoria(id)
        ON DELETE SET NULL
) ENGINE=InnoDB;

-- Presupuestos
CREATE TABLE IF NOT EXISTS presupuesto (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    numero          INT NOT NULL UNIQUE,
    fecha           DATE NOT NULL,
    validez_hasta   DATE,
    cliente_nombre  VARCHAR(120),
    cliente_telefono VARCHAR(40),
    descuento_global DECIMAL(5,2) NOT NULL DEFAULT 0,
    observaciones   TEXT,
    total           DECIMAL(12,2) NOT NULL DEFAULT 0
) ENGINE=InnoDB;

-- Ítems del presupuesto
CREATE TABLE IF NOT EXISTS presupuesto_item (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    presupuesto_id  INT NOT NULL,
    producto_id     INT,
    cantidad        INT NOT NULL DEFAULT 1,
    precio_unitario DECIMAL(12,2) NOT NULL,
    descuento_item  DECIMAL(5,2) NOT NULL DEFAULT 0,

    CONSTRAINT fk_item_presupuesto
        FOREIGN KEY (presupuesto_id) REFERENCES presupuesto(id)
        ON DELETE CASCADE,
    CONSTRAINT fk_item_producto
        FOREIGN KEY (producto_id) REFERENCES producto(id)
        ON DELETE SET NULL
) ENGINE=InnoDB;

