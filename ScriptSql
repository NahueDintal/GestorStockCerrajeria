-- ---------------------------------------------------------------------
-- 7. VISTAS ÚTILES (opcional, pero te salvan la vida)
-- ---------------------------------------------------------------------

-- Vista completa: productos con marca, categoría y detalles
CREATE OR REPLACE VIEW v_productos_completo AS
SELECT
    p.id_producto,
    p.codigo,
    c.nombre    AS categoria,
    c.etiqueta  AS categoria_etiqueta,
    m.nombre    AS marca,
    p.modelo,
    p.tipo,
    p.descripcion,
    p.precio_costo,
    p.precio_venta,
    p.stock,
    p.stock_minimo,
    p.activo,
    cd.cantidad_llaves,
    cr.cantidad_combinaciones,
    md.material
FROM productos p
    JOIN categorias c      ON p.id_categoria = c.id_categoria
    LEFT JOIN marcas m     ON p.id_marca     = m.id_marca
    LEFT JOIN candado_detalle   cd ON p.id_producto = cd.id_producto
    LEFT JOIN cerradura_detalle cr ON p.id_producto = cr.id_producto
    LEFT JOIN manija_detalle    md ON p.id_producto = md.id_producto;

-- Vista: productos con stock bajo
CREATE OR REPLACE VIEW v_stock_bajo AS
SELECT
    p.id_producto,
    p.codigo,
    c.etiqueta AS categoria,
    m.nombre   AS marca,
    p.modelo,
    p.stock,
    p.stock_minimo,
    (p.stock_minimo - p.stock) AS faltante
FROM productos p
    JOIN categorias c  ON p.id_categoria = c.id_categoria
    LEFT JOIN marcas m ON p.id_marca     = m.id_marca
WHERE p.activo = TRUE
  AND p.stock <= p.stock_minimo
ORDER BY faltante DESC;
