<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">

    <!-- ==================== SIDEBAR ==================== -->
    <left>
        <VBox prefHeight="0.0" prefWidth="276.0" spacing="5" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <VBox prefHeight="406.0" prefWidth="236.0" spacing="5" VBox.vgrow="ALWAYS">
   
               <VBox prefHeight="220.0" prefWidth="236.0" spacing="10" VBox.vgrow="ALWAYS">
                   <ToggleButton fx:id="btnPlanilla" styleClass="sidebar-btn" text="Presupuesto" />
                   <ToggleButton fx:id="btnReservas" styleClass="sidebar-btn" text="Cerraduras" />
                   <ToggleButton fx:id="btnHabitaciones" styleClass="sidebar-btn" text="Candados" />
                   <ToggleButton fx:id="btnClientes" styleClass="sidebar-btn" text="Llaves" />
                   <ToggleButton fx:id="btnReportes" styleClass="sidebar-btn" text="Cámaras" />
                   <ToggleButton fx:id="btnPersonal" styleClass="sidebar-btn" text="Alarmas X-28" />
               <ToggleButton fx:id="btnConfiguracion" styleClass="sidebar-btn" text="Monitoreo" />
               </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- ==================== ÁREA CENTRAL ==================== -->
    <center>
        <AnchorPane fx:id="centerPane" BorderPane.alignment="TOP_RIGHT" />
    </center>
</BorderPane>
